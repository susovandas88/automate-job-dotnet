@page
@model NaukriModel
@{
    ViewData["Title"] = "Naukri jobs";
    ViewData["Wide"] = true;
}

<section class="page-intro">
    <p class="eyebrow">Naukri</p>
    <h1>Jobs that fit your resume</h1>
    <p>The Naukri window opens, reads the job list for your search, and stores it here. Scoring uses the same resume and OpenAI key as LinkedIn.</p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.FetchMessage))
{
    <div class="fetch-row">
        <p id="fetch-status" class="@(Model.FetchFailed ? "banner" : "notice")" role="status" data-running="@(Model.FetchRunning ? "true" : "false")">@Model.FetchMessage</p>
        @if (Model.FetchRunning)
        {
            <button type="submit" class="cancel-fetch" form="naukri-form" formaction="?handler=CancelFetch">Cancel fetch</button>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p class="banner" role="alert">@Model.ErrorMessage</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p class="notice">@Model.Message</p>
}

<form id="naukri-form" method="post" enctype="multipart/form-data" class="match-form">
    <input type="hidden" name="p" value="@Model.PageNumber" />
    <input type="hidden" name="from" value="@Model.PostedFrom?.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="to" value="@Model.PostedTo?.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="place" value="@Model.Place" />
    <label class="field">
        <span>OpenAI API key</span>
        <input type="password" name="ApiKey" autocomplete="off" placeholder="sk-..." />
        <small>@(LlmRoute.OpenAiEnabled() ? "Paste a key that starts with sk-. It stays in this browser session and is not shared with other users." : "Optional while OpenAI is off.")</small>
        @if (Model.HasSavedKey)
        {
            <small>A key starting with sk- is saved for this browser session. Paste a new one only to replace it.</small>
        }
        @if (!LlmRoute.OpenAiEnabled())
        {
            <small>OpenAI is off. Scoring uses Gemini from GEMINI_API_KEY in the web .env file.</small>
        }
    </label>
    <label class="field">
        <span>Stored resumes</span>
        <select name="SelectedResumeId">
            <option value="">Paste or upload a new resume</option>
            @foreach (var resume in Model.Resumes)
            {
                if (resume.Id == Model.SelectedResumeId)
                {
                    <option value="@resume.Id" selected>@resume.Name</option>
                }
                else
                {
                    <option value="@resume.Id">@resume.Name</option>
                }
            }
        </select>
    </label>
    <div class="columns">
        <label class="field">
            <span>Resume file</span>
            <input type="file" name="ResumeFile" accept=".pdf,.docx,.txt,application/pdf,text/plain" />
        </label>
        <label class="field">
            <span>Resume text</span>
            <textarea name="ResumeText" rows="8" placeholder="Paste your resume if you are not uploading a file.">@Model.ResumeText</textarea>
        </label>
    </div>
    <div class="columns">
        <label class="field">
            <span>Search keywords</span>
            <input type="text" name="Keywords" value="@Model.Keywords" maxlength="160" placeholder="dotnet developer" />
        </label>
        <label class="field">
            <span>Location</span>
            <input type="text" name="Location" value="@Model.Location" maxlength="120" placeholder="Bengaluru" />
        </label>
    </div>
    <label class="check">
        <input type="checkbox" name="ShowWeakMatches" value="true" @(Model.ShowWeakMatches ? "checked" : "") />
        <span>Show weak matches below 55</span>
    </label>
    <div class="actions">
        @if (Model.FetchRunning)
        {
            <button type="button" disabled>Fetching…</button>
            <button type="submit" class="cancel-fetch" asp-page-handler="CancelFetch">Cancel fetch</button>
        }
        else
        {
            <button type="submit" asp-page-handler="Fetch">Fetch jobs</button>
        }
    </div>
    <p class="hint">Fetch jobs keeps running in the Naukri window while you use the rest of the application. Check the rows you want, then click Evaluate selected.</p>
</form>

<partial name="_ResumeGrid" model="Model.Resumes" />

<form method="get" class="date-filter">
    <label class="field">
        <span>Posted from</span>
        <input type="date" name="from" value="@Model.PostedFrom?.ToString("yyyy-MM-dd")" />
    </label>
    <label class="field">
        <span>Posted to</span>
        <input type="date" name="to" value="@Model.PostedTo?.ToString("yyyy-MM-dd")" />
    </label>
    <label class="field">
        <span>Location</span>
        <select name="place">
            <option value="">All locations</option>
            @foreach (var place in Model.Places)
            {
                if (string.Equals(place, Model.Place, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@place" selected>@place</option>
                }
                else
                {
                    <option value="@place">@place</option>
                }
            }
        </select>
    </label>
    <label class="check">
        <input type="checkbox" name="ShowWeakMatches" value="true" @(Model.ShowWeakMatches ? "checked" : "") />
        <span>Show weak matches below 55</span>
    </label>
    <button type="submit">Filter</button>
</form>
<script src="~/js/filter-scroll.js" asp-append-version="true"></script>

@if (Model.TotalJobs == 0)
{
    <p class="empty-list">No Naukri jobs in the list yet.</p>
}
else
{
    <p class="list-meta">Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1)–@(((Model.PageNumber - 1) * Model.PageSize) + Model.Jobs.Count) of @Model.TotalJobs</p>
    <div class="actions list-actions">
        <button type="submit" form="naukri-form" asp-page-handler="EvaluateSelected">Evaluate selected</button>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="check-col"><input type="checkbox" class="row-check" id="select-all-naukri" aria-label="Select all jobs on this page" /></th>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Posted</th>
                    <th>Score</th>
                    <th>Covered</th>
                    <th>Missing</th>
                    <th>Link</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td class="check-col"><input type="checkbox" class="row-check" form="naukri-form" name="SelectedJobUrls" value="@job.JobUrl" aria-label="Select @job.Title" /></td>
                        <td>@job.Title</td>
                        <td>@job.Company</td>
                        <td>@job.Location</td>
                        <td>@(string.IsNullOrWhiteSpace(job.Posted) ? "—" : job.Posted)</td>
                        <td>@(job.Score?.ToString() ?? "Not scored")</td>
                        <td>@string.Join(", ", job.Covered)</td>
                        <td>@string.Join(", ", job.Missing)</td>
                        <td><a href="@job.JobUrl" target="_blank" rel="noopener">Open</a></td>
                        <td class="row-actions">
                            <button type="submit" class="secondary row-action" form="naukri-form" asp-page-handler="Evaluate" name="EvaluateUrl" value="@job.JobUrl">Evaluate</button>
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(job.Summary) || !string.IsNullOrWhiteSpace(job.Error))
                    {
                        <tr class="detail">
                            <td colspan="10">@(job.Error ?? job.Summary)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <nav class="pager" aria-label="Job pages">
        @if (Model.PageNumber > 1)
        {
            <a href="@Model.PageLink(Model.PageNumber - 1)">Previous</a>
        }
        @if (Model.PageNumber < Model.PageCount)
        {
            <a href="@Model.PageLink(Model.PageNumber + 1)">Next</a>
        }
    </nav>
}

<script>
    (function () {
        const all = document.getElementById("select-all-naukri");
        if (!all) return;
        all.addEventListener("change", function () {
            document.querySelectorAll("input[name='SelectedJobUrls']").forEach(function (box) { box.checked = all.checked; });
        });
    })();
</script>
@if (Model.FetchRunning)
{
    <script>
        (function () {
            const notice = document.getElementById("fetch-status");
            if (!notice) return;
            const timer = setInterval(async function () {
                try {
                    const response = await fetch("/Naukri?handler=FetchStatus", { headers: { "Accept": "application/json" } });
                    if (!response.ok) return;
                    const status = await response.json();
                    notice.textContent = status.message || notice.textContent;
                    notice.className = status.failed ? "banner" : "notice";
                    if (status.running) return;
                    clearInterval(timer);
                    const active = document.activeElement;
                    const typing = active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.tagName === "SELECT");
                    if (!typing) location.reload();
                } catch (e) { }
            }, 3000);
        })();
    </script>
}
