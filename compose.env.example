# Copy to compose.env and fill the auth values. compose.env is not committed.
# Do not put OPENAI_API_KEY here. Paste that key in the browser.
Auth__JwtKey=
Auth__PasswordHash=
Auth__Username=
OPENAI_ENABLED=true
